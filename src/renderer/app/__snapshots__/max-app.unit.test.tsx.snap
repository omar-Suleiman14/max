exports[`Max shell > renders the English shell and navigates to Databases workspace 1`] = `
<div
  class="app-frame"
>
  <header
    class="topbar"
  >
    <div
      class="topbar__title"
    >
      <bdi>
        Test Shop
      </bdi>
      <span
        aria-hidden="true"
      >
        /
      </span>
      <bdi>
        <strong>
          Databases
        </strong>
      </bdi>
    </div>
