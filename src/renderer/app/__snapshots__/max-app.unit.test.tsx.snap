            points="3.29 7 12 12 20.71 7"
          />
          <path
            d="m7.5 4.27 9 5.15"
          />
        </svg>
      </div>
      <p
        class="eyebrow"
      >
        Create something
      </p>
      <h2>
        No items yet
      </h2>
      <p>
        Create an item when your workspace has the properties your shop actually needs.
      </p>
      <div
        class="empty-state__actions"
      >
        <button
          class="button button--primary"
