      </section>
      <section
        aria-label="مساحة العمل"
        class="principle-grid"
      >
        <article
          class="principle-card"
        >
          <span
            class="principle-card__number"
          >
            0
            1
          </span>
          <h3>
            محلي افتراضيًا
          </h3>
          <p>
            تبقى مساحة SQLite هي المرجع وتعمل من دون اتصال بالإنترنت.
          </p>
        </article>
        <article
          class="principle-card"
        >
          <span
            class="principle-card__number"
          >
            0
            2
          </span>
          <h3>
            جاهز للتخصيص
          </h3>
          <p>
            واجهة العمل جاهزة، وبنية المتجر ما زالت منفصلة عن قصد.
          </p>
        </article>
        <article
          class="principle-card"
        >
          <span
            class="principle-card__number"
          >
            0
            3
          </span>
          <h3>
            مصمم للسرعة
          </h3>
          <p>
            مسارات لوحة المفاتيح والإجراءات المركزة متاحة في كل مكان.
          </p>
        </article>
      </section>
      <section
        class="keyboard-note"
      >
        <kbd>
          Tab
        </kbd>
        <kbd>
          Enter
        </kbd>
        <kbd>
          Esc
        </kbd>
        <kbd>
          ↑ ↓
        </kbd>
        <div>
          <strong>
            لوحة المفاتيح
          </strong>
          <p>
            ينتقل Tab للأمام ويفعّل Enter ويغلق Escape وتتنقل الأسهم داخل القوائم.
          </p>
        </div>
      </section>
    </div>
  </main>
</div>
`;
