exports[`Max shell > renders the English shell and an actionable empty page 1`] = `
<div
  class="app-frame"
>
  <header
    class="topbar"
  >
    <div
      class="topbar__title"
    >
      <p>
        Workspace
         /
      </p>
      <strong>
        Items
      </strong>
    </div>
    <div
