exports[`Max shell > switches the complete shell to Arabic and RTL 1`] = `
<div
  class="app-frame"
>
  <header
    class="topbar"
  >
    <div
      class="topbar__title"
    >
      <bdi>
        Test Shop
      </bdi>
      <span
        aria-hidden="true"
      >
        /
      </span>
      <bdi>
        <strong>
          Home
        </strong>
      </bdi>
    </div>
    <div
      class="topbar__actions"
    >
      <button
        class="command-trigger"
        type="button"
      >
        <svg
          aria-hidden="true"
          class="lucide lucide-search"
          fill="none"
          height="17"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="17"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="m21 21-4.34-4.34"
          />
          <circle
            cx="11"
            cy="11"
            r="8"
          />
        </svg>
        <span>
          ابحث في البيانات
        </span>
        <kbd>
          Ctrl
           F
        </kbd>
      </button>
      <button
        class="button button--ghost quick-entry-trigger"
        type="button"
      >
        <span
          class="button__icon"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-zap"
            fill="none"
            height="16"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            width="16"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M15.914 4a1.5 1.5 0 00-2.474-1.561l-9 9A1.5 1.5 0 005.5 14h4.002a.5.5 0 01.471.666L8.086 20a1.5 1.5 0 002.475 1.56l9-9A1.5 1.5 0 0018.5 10h-3.997a.5.5 0 01-.472-.667z"
            />
          </svg>
        </span>
        <span
          class="button__label"
        >
          عملية سريعة
        </span>
      </button>
    </div>
  </header>
  <main
    aria-label="Home"
    class="content"
    data-custom-page="false"
    data-page="home"
    id="main-content"
    tabindex="-1"
  >
    <div
      class="custom-page-view"
    >
      <div
        class="custom-page-header"
      >
        <div
          class="custom-page-header__icon-wrap"
        >
