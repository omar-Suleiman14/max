            cx="11"
            cy="11"
            r="8"
          />
        </svg>
        <span>
          Search commands
        </span>
        <kbd>
          Ctrl
           K
        </kbd>
      </button>
      <div
        class="create-menu"
      >
        <button
          aria-expanded="false"
          aria-haspopup="menu"
          class="button button--primary"
          type="button"
        >
