          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="17"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="m21 21-4.34-4.34"
          />
          <circle
            cx="11"
            cy="11"
            r="8"
          />
        </svg>
        <span>
          Search data
        </span>
        <kbd>
          Ctrl
           F
        </kbd>
      </button>
      <button
        class="button button--ghost quick-entry-trigger"
        type="button"
      >
        <span
          class="button__icon"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-zap"
