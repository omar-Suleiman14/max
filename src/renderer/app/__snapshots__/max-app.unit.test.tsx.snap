              fill="none"
              height="15"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="15"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="m6 9 6 6 6-6"
              />
            </svg>
          </span>
        </button>
      </div>
    </div>
  </header>
  <main
    aria-labelledby="page-title"
    class="content"
    id="main-content"
    tabindex="-1"
  >
    <header
      class="page-header"
    >
      <div>
        <p
          class="eyebrow"
        >
          مساحة العمل
        </p>
        <h1
          id="page-title"
        >
          الرئيسية
        </h1>
        <p>
          نقطة بداية هادئة للعمل المهم اليوم.
        </p>
      </div>
    </header>
    <div
      class="home-page"
    >
      <section
        class="home-hero"
      >
        <div
          aria-hidden="true"
          class="home-hero__glow"
        />
        <p
          class="eyebrow"
        >
          MAX · LOCAL WORKSPACE
        </p>
        <h2>
          متجرُك، بطريقتك
        </h2>
        <p>
          يعمل ماكس محليًا ويتشكل حسب إعدادات متجرك.
        </p>
        <div
          class="home-hero__actions"
        >
