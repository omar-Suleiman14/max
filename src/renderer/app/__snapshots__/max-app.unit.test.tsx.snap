              stroke-linejoin="round"
              stroke-width="2"
              viewBox="0 0 24 24"
              width="18"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M5 12h14"
              />
              <path
                d="M12 5v14"
              />
            </svg>
          </span>
          <span
            class="button__label"
          >
            Create item
          </span>
        </button>
        <button
          class="button button--secondary"
          type="button"
        >
          <span
            class="button__icon"
          >
            <svg
              aria-hidden="true"
              class="lucide lucide-search"
              fill="none"
