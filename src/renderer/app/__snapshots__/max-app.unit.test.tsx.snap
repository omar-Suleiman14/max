            aria-label="تغيير الرمز أو الأيقونة"
            class="custom-page-icon-btn"
            title="تغيير الرمز أو الأيقونة"
            type="button"
          >
            <svg
              aria-hidden="true"
              class="lucide lucide-house custom-page-icon-display"
              fill="none"
              height="28"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.8"
              viewBox="0 0 24 24"
              width="28"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"
              />
              <path
                d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
              />
            </svg>
          </button>
        </div>
        <div
          class="custom-page-header__title-row"
        >
          <input
