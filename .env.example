# Max Environment Configuration Template
# Copy this file to .env.local to configure optional cloud backups and authentication.
# Max remains fully operational offline even when these are not set.

# Clerk Authentication (Publishable key is safe for client-side)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key

# Cloudflare Worker API URL (compiled only into Electron main, not renderer)
MAX_BACKUP_WORKER_URL=https://max-backup-worker.your-subdomain.workers.dev
